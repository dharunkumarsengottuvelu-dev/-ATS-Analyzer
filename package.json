{
  "name": "ats-resume-analyzer-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": ".\\\\backend\\\\.venv\\\\Scripts\\\\python.exe -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -c \"cyan,magenta\" -n \"backend,frontend\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "build": "npm run build --prefix frontend"
  },
  "dependencies": {
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
